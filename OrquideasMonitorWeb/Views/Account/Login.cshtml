@{
    ViewData["Title"] = "Acceso - Invernadero de Orquídeas";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center min-vh-100 py-4">

    <div class="container" style="max-width: 480px;">
        <div class="card shadow border-0 rounded-4 overflow-hidden">

            <div class="card-header bg-success text-white text-center py-3">
                <h5 class="mb-0 fw-bold">🌺 Invernadero de Orquídeas</h5>
                <small class="opacity-75">Control de Acceso al Sistema IoT</small>
            </div>

            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
                }

                <!-- Pestañas de método de ingreso -->
                <ul class="nav nav-pills nav-fill mb-3" id="tabsAcceso" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-credenciales" data-bs-toggle="pill" data-bs-target="#panel-credenciales" type="button">🔑 Credenciales</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-facial" data-bs-toggle="pill" data-bs-target="#panel-facial" type="button" onclick="iniciarCamaraSiNoExiste()">📷 Reconocimiento Facial</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- MODO 1: USUARIO Y CONTRASEÑA -->
                    <div class="tab-pane fade show active" id="panel-credenciales">
                        <form asp-action="LoginCredenciales" method="post">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Usuario</label>
                                <input type="text" name="usuario" class="form-control" placeholder="Ej: admin" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Contraseña</label>
                                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                            </div>
                            <button type="submit" class="btn btn-success w-100 fw-semibold">Ingresar al Monitor</button>
                        </form>
                    </div>

                    <!-- MODO 2: RECONOCIMIENTO FACIAL (face-api.js) -->
                    <div class="tab-pane fade text-center" id="panel-facial">
                        <div class="position-relative d-inline-block w-100 rounded-3 overflow-hidden bg-black mb-3" style="height: 300px;">
                            <video id="video" autoplay playsinline muted class="w-100 h-100" style="object-fit: cover; transform: scaleX(-1);"></video>
                        </div>

                        <div class="p-2 mb-2 bg-light rounded-3 border text-start">
                            <span class="text-muted d-block small">Usuario detectado:</span>
                            <span id="lblNombre" class="h6 fw-bold text-secondary mb-0">Buscando rostro...</span>
                            <small id="lblDistancia" class="d-block text-muted" style="font-size: 0.78rem;"></small>
                        </div>

                        <div id="estadoMensaje" class="alert alert-info py-2 mb-3 small">
                            Esperando activación de cámara...
                        </div>

                        <!-- Enrolamiento rápido de rostro para miembros del equipo -->
                        <details class="text-start border rounded-3 p-2 bg-light">
                            <summary class="small fw-semibold text-success" style="cursor:pointer;">➕ Registrar mi rostro por primera vez</summary>
                            <div class="mt-2">
                                <input type="text" id="regUsuario" class="form-control form-control-sm mb-2" placeholder="Tu usuario (ej: admin)" />
                                <input type="password" id="regPassword" class="form-control form-control-sm mb-2" placeholder="Tu contraseña" />
                                <button type="button" class="btn btn-outline-success btn-sm w-100" onclick="capturarYGuardarRostro()">Capturar y Guardar Rostro</button>
                            </div>
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@@0.22.2/dist/face-api.min.js"></script>

    <script>
        const video = document.getElementById('video');
        const estadoMensaje = document.getElementById('estadoMensaje');
        const lblNombre = document.getElementById('lblNombre');
        const lblDistancia = document.getElementById('lblDistancia');

        let baseUsuarios = [];
        let faceMatcher = null;
        let loginEnProgreso = false;
        let camaraIniciada = false;

        async function iniciarCamaraSiNoExiste() {
            if (camaraIniciada) return;
            camaraIniciada = true;

            try {
                estadoMensaje.textContent = 'Cargando modelos neuronales...';
                const MODEL_URL = 'https://raw.githubusercontent.com/justadudewhohacks/face-api.js/master/weights';

                await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
                await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
                await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);

                await recargarDescriptores();

                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
                    audio: false
                });
                video.srcObject = stream;

                video.addEventListener('play', () => {
                    estadoMensaje.className = 'alert alert-success py-2 mb-3 small';
                    estadoMensaje.textContent = 'Cámara activa. Mire fijamente al lente.';
                    iniciarEscaneo();
                });
            } catch (error) {
                camaraIniciada = false;
                estadoMensaje.className = 'alert alert-danger py-2 mb-3 small';
                estadoMensaje.textContent = 'Error de cámara: ' + error.message;
            }
        }

        async function recargarDescriptores() {
            const res = await fetch('/api/auth/usuarios-rostros');
            baseUsuarios = await res.json();

            const labeled = [];
            baseUsuarios.forEach(u => {
                if (u.descriptorFacial) {
                    const desc = new Float32Array(JSON.parse(u.descriptorFacial));
                    labeled.push(new faceapi.LabeledFaceDescriptors(u.id.toString(), [desc]));
                }
            });
            faceMatcher = labeled.length > 0 ? new faceapi.FaceMatcher(labeled, 0.65) : null;
        }

        function iniciarEscaneo() {
            setInterval(async () => {
                if (video.paused || video.ended || loginEnProgreso) return;

                const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks()
                    .withFaceDescriptor();

                if (detection && faceMatcher) {
                    const match = faceMatcher.findBestMatch(detection.descriptor);
                    lblDistancia.textContent = `Margen: ${match.distance.toFixed(3)} (umbral: 0.650)`;

                    if (match.label !== 'unknown') {
                        const usuario = baseUsuarios.find(u => u.id.toString() === match.label);
                        if (usuario) {
                            loginEnProgreso = true;
                            lblNombre.textContent = usuario.nombreCompleto;
                            lblNombre.className = "h6 fw-bold text-success mb-0";
                            estadoMensaje.className = 'alert alert-primary py-2 mb-3 small';
                            estadoMensaje.textContent = 'Identidad confirmada. Ingresando...';

                            setTimeout(async () => {
                                const resp = await fetch('/api/auth/login-facial', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ usuarioId: usuario.id })
                                });
                                const data = await resp.json();
                                if (data.exito) window.location.href = data.redirectUrl;
                            }, 800);
                            return;
                        }
                    }
                    lblNombre.textContent = "Rostro no registrado";
                    lblNombre.className = "h6 fw-bold text-warning mb-0";
                } else if (!detection) {
                    lblNombre.textContent = "Buscando rostro...";
                    lblNombre.className = "h6 fw-bold text-secondary mb-0";
                    lblDistancia.textContent = "";
                }
            }, 600);
        }

        async function capturarYGuardarRostro() {
            const usuario = document.getElementById('regUsuario').value.trim();
            const password = document.getElementById('regPassword').value;
            if (!usuario || !password) return alert("Ingresa tu usuario y contraseña primero.");

            const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
                .withFaceLandmarks()
                .withFaceDescriptor();

            if (!detection) return alert("No se detecta un rostro claro frente a la cámara.");

            const descriptorJson = JSON.stringify(Array.from(detection.descriptor));
            const resp = await fetch('/api/auth/registrar-rostro', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuario, password, descriptorFacial: descriptorJson })
            });
            const data = await resp.json();
            alert(data.mensaje);
            if (data.exito) await recargarDescriptores();
        }
    </script>
</body>
</html>